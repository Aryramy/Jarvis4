# JARVIS4 Environment Configuration Example

# Application Environment (development, test, production)
NODE_ENV=development

# Logging Level (debug, info, warn, error)
LOG_LEVEL=info

# Cheaper Inference AI Provider Configuration (Brick 3)
CHEAPER_INFERENCE_API_KEY=
CHEAPER_INFERENCE_BASE_URL=https://api.cheaperinference.com/v1
CHEAPER_INFERENCE_MODEL=
CHEAPER_INFERENCE_TIMEOUT_MS=30000

# OpenRouter Speech-to-Text Provider Configuration (Brick 10)
OPENROUTER_API_KEY=
OPENROUTER_STT_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_STT_MODEL=openai/whisper-large-v3-turbo
OPENROUTER_STT_TIMEOUT_MS=30000

# OpenRouter Text-to-Speech Provider Configuration (Brick 12)
OPENROUTER_TTS_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TTS_MODEL=elevenlabs/eleven-v4-turbo
OPENROUTER_TTS_VOICE=george
OPENROUTER_TTS_TIMEOUT_MS=30000
